{
  "expo": {
    "name": "Life on Wheels: The Real Life Simulator",
    "slug": "life-on-wheels",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "lifeonwheels",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yousef.cargame",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0D14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47075554-e137-41bc-8635-35692cab9c49"
      }
    }
  }
}
