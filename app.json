{
  "expo": {
    "name": "Life on Wheels: The Real Life Simulator",
    "slug": "life-on-wheels",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "lifeonwheels",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0D14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
