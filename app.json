{
  "expo": {
    "name": "Life on Wheels: The Real Life Simulator",
    "slug": "life-on-wheels",
    "version": "1.2.0",
    "orientation": "landscape",
    "scheme": "lifeonwheels",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/47075554-e137-41bc-8635-35692cab9c49"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-dontwarn expo.modules.**\n-dontwarn **",
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yousef.cargame",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#0A0D14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47075554-e137-41bc-8635-35692cab9c49"
      }
    },
    "icon": "./assets/icon.png"
  }
}